{
  "name": "convax-comic",
  "version": "0.1.0",
  "private": true,
  "description": "Convax Comic desktop product over DeepSeek Harness and Cordis",
  "license": "UNLICENSED",
  "packageManager": "yarn@4.18.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "workspaces": [
    "app/desktop",
    "app/packages/*",
    "app/plugins/*"
  ],
  "dependencies": {
    "@convax/canvas-api": "workspace:*",
    "@convax/canvas-builtins": "workspace:*",
    "@convax/canvas-store-api": "workspace:*",
    "@convax/canvas-store-sqlite": "workspace:*",
    "@convax/project": "workspace:*",
    "@convax/runtime": "workspace:*",
    "@convax/sqlite-runtime": "workspace:*",
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh": "0.1.1-rc.2",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-attachment": "0.1.1-rc.2",
    "@deepseek-ai/dsh-brand": "0.1.1-rc.2",
    "@deepseek-ai/dsh-code-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.1-rc.2",
    "@deepseek-ai/dsh-invariants": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-scope": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.1-rc.2",
    "@deepseek-ai/dsh-timeout": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.1.1-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.1",
    "react": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.1",
    "electron": "43.4.0",
    "electron-builder": "26.15.7",
    "tsdown": "0.22.2",
    "typescript": "6.0.3",
    "vitest": "4.1.8",
    "yaml": "^2.9.0"
  },
  "dependenciesMeta": {
    "@deepseek-ai/dsh-subprocess-local": {
      "built": true
    },
    "electron": {
      "built": true
    },
    "esbuild": {
      "built": true
    }
  },
  "scripts": {
    "build": "yarn workspaces foreach -A --topological-dev run build",
    "typecheck": "yarn workspaces foreach -A --parallel run typecheck",
    "test": "yarn workspaces foreach -A --parallel run test",
    "check:profiles": "node app/scripts/check-profiles.mjs",
    "check:dump-config": "node app/scripts/check-dump-config.mjs",
    "check:layout": "node app/scripts/verify-layout.mjs",
    "check:ci-config": "node app/scripts/check-ci.mjs",
    "check:node-compat": "yarn build && yarn typecheck && yarn test",
    "check": "yarn check:ci-config && yarn check:layout && yarn build && yarn typecheck && yarn test && yarn check:profiles && yarn check:dump-config",
    "dump-config": "node app/scripts/dump-config.mjs default",
    "dump-config:compatibility": "node app/scripts/dump-config.mjs compatibility",
    "smoke:upstream": "node app/scripts/upstream-smoke.mjs",
    "dev": "yarn build && yarn workspace @convax/desktop dev",
    "start": "yarn workspace @convax/desktop start",
    "package:dir": "yarn build && yarn workspace @convax/desktop package:dir",
    "upstream:version": "node app/scripts/upstream-command.mjs version",
    "upstream:install": "node app/scripts/upstream-command.mjs install",
    "upstream:build": "node app/scripts/upstream-command.mjs build"
  }
}
