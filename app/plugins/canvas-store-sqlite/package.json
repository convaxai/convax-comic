{
  "name": "@convax/canvas-store-sqlite",
  "version": "0.1.0",
  "private": true,
  "description": "SQLite-backed CanvasStore provider for Convax Comic",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "host": {
      "inject": [
        "@convax/sqlite-runtime"
      ]
    }
  },
  "peerDependencies": {
    "@convax/canvas-api": "workspace:*",
    "@convax/canvas-store-api": "workspace:*",
    "@convax/sqlite-runtime": "workspace:*",
    "@deepseek-ai/cordis": "4.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "tsdown": "0.22.2",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  },
  "files": [
    "lib/**"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  }
}
