  "devDependencies": {
    "@types/node": "^22.20.0",
    "electron": "43.4.0",
    "electron-builder": "26.15.7",
    "tsdown": "0.22.2",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  },
  "build": {
    "appId": "com.convax.comic",
    "productName": "Convax Comic",
    "electronVersion": "43.4.0",
    "asar": false,
    "npmRebuild": false,
    "files": [
      "lib/**",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "../profiles",
        "to": "profiles",
        "filter": [
          "security.patch.yml",
          "default/package.json",
          "default/cordis.patch.yml",
          "compatibility/package.json",
          "compatibility/cordis.patch.yml"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ]
    }
  }
