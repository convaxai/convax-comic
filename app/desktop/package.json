{
  "name": "@convax/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal authenticated Electron shell for Convax Comic",
  "type": "module",
  "main": "lib/main.js",
  "bin": {
    "convax-desktop": "lib/bin.js"
  },
  "exports": {
    ".": "./lib/plugin.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**",
    "README.md"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "yarn run build && yarn run typecheck && yarn run test",
    "start": "node lib/bin.js --profile default",
    "dev": "yarn run build && yarn run start",
    "verify:runtime": "node scripts/verify-runtime.mjs",
    "package:dir": "yarn run build && yarn run verify:runtime && node scripts/package-dir.mjs"
  },
  "dependencies": {
    "@convax/agent-presets": "workspace:*",
